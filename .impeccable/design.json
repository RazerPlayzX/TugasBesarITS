  "components": [
    {
      "name": "Tombol primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Varian tombol sesuai implementasi; danger tidak memiliki warna hover khusus.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Cari rekomendasi</button>",
      "css": ".ds-button-primary{min-height:44px;padding:10px 18px;border-radius:var(--control-radius);border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:10px;font:600 13px/1.5 var(--font);text-decoration:none;cursor:pointer;transition:background var(--duration) var(--ease);background:var(--accent);color:var(--paper);}.ds-button-primary:hover:not(:disabled){background:var(--forest-hover);}.ds-button-primary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-button-primary:disabled{cursor:not-allowed;opacity:.6;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;animation:none!important}}.ds-button-primary:active{filter:brightness(.92)}"
    },
    {
      "name": "Tombol secondary",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Varian tombol sesuai implementasi; danger tidak memiliki warna hover khusus.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Lanjutkan quest</button>",
      "css": ".ds-button-secondary{min-height:44px;padding:10px 18px;border-radius:var(--control-radius);border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:10px;font:600 13px/1.5 var(--font);text-decoration:none;cursor:pointer;transition:background var(--duration) var(--ease);background:var(--paper);color:var(--forest);border-color:var(--input-line);}.ds-button-secondary:hover:not(:disabled){background:var(--mint);}.ds-button-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-button-secondary:disabled{cursor:not-allowed;opacity:.6;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none!important;animation:none!important}}.ds-button-secondary:active{filter:brightness(.92)}"
    },
    {
      "name": "Tombol danger",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Varian tombol sesuai implementasi; danger tidak memiliki warna hover khusus.",
      "html": "<button class=\"ds-button-danger\" type=\"button\">Ya, reset demo</button>",
      "css": ".ds-button-danger{min-height:44px;padding:10px 18px;border-radius:var(--control-radius);border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:10px;font:600 13px/1.5 var(--font);text-decoration:none;cursor:pointer;transition:background var(--duration) var(--ease);background:var(--error);color:var(--paper);}.ds-button-danger:hover:not(:disabled){background:var(--error);}.ds-button-danger:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-button-danger:disabled{cursor:not-allowed;opacity:.6;}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none!important;animation:none!important}}.ds-button-danger:active{filter:brightness(.92)}"
    },
    {
      "name": "Preset",
      "kind": "button",
      "refersTo": "button-preset",
      "description": "Aksi contoh dengan ikon arah SVG.",
      "html": "<button class=\"ds-preset\" type=\"button\">Python<svg aria-hidden=\"true\" viewBox=\"0 0 16 16\"><path d=\"M3 8h10m-4-4 4 4-4 4\"/></svg></button>",
      "css": ".ds-preset{border:1px solid var(--line);background:var(--paper);border-radius:6px;color:var(--forest);padding:8px 12px;min-height:44px;font:13px/1.6 var(--font);display:inline-flex;align-items:center;gap:14px;cursor:pointer}.ds-preset svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-preset:hover{border-color:var(--forest);background:var(--mint)}.ds-preset:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-preset:active{filter:brightness(.92)}"
    },
    {
      "name": "Isian",
      "kind": "input",
      "refersTo": "input",
      "description": "Label persisten, bantuan, border validasi, dan fokus keyboard.",
      "html": "<div class=\"ds-field\"><label for=\"ds-topic\">Topik atau keterampilan</label><input id=\"ds-topic\" type=\"text\" placeholder=\"Contoh: python programming\" aria-describedby=\"ds-topic-hint\"><p id=\"ds-topic-hint\">Gunakan topik berbahasa Inggris.</p></div>",
      "css": ".ds-field{font:15px/1.6 var(--font);color:var(--ink)}.ds-field label{display:block;font-size:13px;font-weight:600;margin-bottom:8px}.ds-field input{width:100%;height:48px;background:var(--paper);color:var(--ink);border:1px solid var(--input-line);border-radius:var(--control-radius);padding:10px 13px;min-width:0;font:inherit;caret-color:var(--forest)}.ds-field input::placeholder{color:#65736b;opacity:1}.ds-field input[aria-invalid=\"true\"]{border-color:var(--error)}.ds-field input:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-field p{font-size:13px;color:var(--muted);margin:6px 0 0}"
    },
    {
      "name": "Navigasi",
      "kind": "nav",
      "refersTo": "nav-current",
      "description": "Empat tujuan pada rail pinus; contoh menampilkan disclosure ponsel dalam keadaan terbuka. Implementasi navigation.js mengatur aria-expanded/hidden, Escape dengan fokus kembali, dan penutupan saat rute berubah.",
      "html": "<div class=\"ds-nav-shell\"><button class=\"ds-menu-toggle\" type=\"button\" aria-expanded=\"true\" aria-controls=\"ds-main-nav\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg>Menu</button><nav id=\"ds-main-nav\" class=\"ds-nav\" aria-label=\"Navigasi contoh\"><a href=\"#beranda\" aria-current=\"page\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m3 10 9-7 9 7v10h-7v-7h-4v7H3Z\"/></svg>Beranda</a><a href=\"#rekomendasi\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z\"/></svg>Rekomendasi Materi</a><a href=\"#quest\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"5\" r=\"2\"/><circle cx=\"18\" cy=\"19\" r=\"2\"/><path d=\"M6 7v7a5 5 0 0 0 5 5h5M8 5h6a4 4 0 0 1 0 8h-3\"/></svg>Quest Saya</a><a href=\"#progres\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 20h16M7 16v-5m5 5V4m5 12V8\"/></svg>Pencapaian</a></nav></div>",
      "css": ".ds-nav-shell{background:var(--forest);padding:20px;font-family:var(--font)}.ds-nav{display:grid;gap:8px}.ds-nav a{display:flex;align-items:center;gap:12px;min-height:48px;padding:12px;color:#c9ded3;font-size:13px;line-height:1.6;text-decoration:none;border-radius:var(--control-radius)}.ds-nav a:hover{background:#235346}.ds-nav a[aria-current]{background:var(--lime);color:var(--forest);font-weight:650}.ds-nav a:focus-visible,.ds-menu-toggle:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-nav-shell svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-menu-toggle{display:none}@media(max-width:700px){.ds-menu-toggle{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;min-height:44px;background:transparent;color:#f4f8f1;border:1px solid #829d8b;border-radius:var(--control-radius);font:15px/1.6 var(--font);margin-bottom:12px;cursor:pointer}.ds-menu-toggle:hover,.ds-menu-toggle[aria-expanded=\"true\"]{background:var(--forest-hover)}.ds-nav{grid-template-columns:1fr;gap:4px}.ds-nav a{justify-content:start;gap:6px;padding:10px 5px;font-size:15px;min-height:46px}.ds-nav svg{width:16px;height:16px}}"
    },
    {
      "name": "Tag status",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Label informasi mint; tidak interaktif.",
      "html": "<span class=\"ds-tag\">Sudah selesai</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:5px;font:600 13px/1.6 var(--font);color:var(--forest);background:var(--mint)}"
    },
    {
      "name": "Panel kerja",
      "kind": "card",
      "refersTo": "panel",
      "description": "Bidang putih berborder dengan judul Manrope.",
      "html": "<section class=\"ds-panel\"><h2>Kebutuhan belajarmu</h2><p>Mulai dari yang kamu butuhkan.</p></section>",
      "css": ".ds-panel{padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);color:var(--ink);font:15px/1.6 var(--font)}.ds-panel h2{font:650 19px/1.35 var(--font-heading);letter-spacing:-.02em;margin:0 0 24px}.ds-panel p{font-size:13px;color:var(--muted);margin:0}@media(max-width:1180px){.ds-panel{padding:22px}}@media(max-width:700px){.ds-panel{padding:22px 18px}.ds-panel h2{font-size:18px}}"
    },
    {
      "name": "Baris selesai",
      "kind": "custom",
      "description": "Signature indeks yang berubah menjadi centang; status juga tertulis.",
      "html": "<div class=\"ds-row\"><span class=\"ds-index\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"m4 12 5 5L20 6\"/></svg></span><div><span class=\"ds-row-tag\">Sudah selesai</span><h3>Materi belajar</h3><a href=\"#quest\">Buka materi</a></div></div>",
      "css": ".ds-row{display:grid;grid-template-columns:32px minmax(0,1fr);gap:16px;padding:24px 0;border-top:1px solid var(--line);color:var(--ink);font:15px/1.6 var(--font)}.ds-index{width:30px;height:30px;border-radius:50%;background:var(--forest);color:var(--paper);display:grid;place-items:center}.ds-index svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-row-tag{display:inline-flex;padding:3px 9px;border-radius:5px;font-size:13px;font-weight:600;color:var(--forest);background:var(--mint)}.ds-row h3{font:600 18px/1.4 var(--font-heading);letter-spacing:-.015em;margin:7px 0 0;overflow-wrap:anywhere}.ds-row a{display:inline-flex;align-items:center;min-height:44px;color:var(--forest);font-size:13px;font-weight:600;text-underline-offset:4px;margin-top:16px}.ds-row a:hover{text-decoration-thickness:2px}.ds-row a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}@media(max-width:700px){.ds-row{grid-template-columns:26px minmax(0,1fr);gap:12px}.ds-index{width:26px;height:26px}.ds-row h3{font-size:17px}}"
    },
    {
      "name": "Badge diperoleh",
      "kind": "card",
      "refersTo": "badge-earned",
      "description": "Bidang kuning untuk penghargaan yang sudah tercatat.",
      "html": "<section class=\"ds-badge\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m12 3 3 3 4 1v5l-3 4-4 2-4-2-3-4V7l4-1Zm-4 13-1 6 5-3 5 3-1-6\"/></svg><h3>Pencapaian belajar</h3><p>Aktivitas sudah tercatat.</p><span>Sudah diperoleh</span></section>",
      "css": ".ds-badge{padding:22px 16px;text-align:center;border:1px solid transparent;border-radius:var(--radius);background:var(--yellow);color:var(--ink);font:15px/1.6 var(--font)}.ds-badge svg{width:32px;height:32px;color:#6c5c17;margin:0 auto 10px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-badge h3{font:700 14px/1.4 var(--font-heading);letter-spacing:-.015em;margin:0}.ds-badge p{font-size:13px;color:var(--muted);margin:6px 0}.ds-badge span{font-size:13px;font-weight:600}@media(max-width:700px){.ds-badge{padding:20px 12px}}"
    },
    {
      "name": "Aktivitas Beranda",
      "kind": "card",
      "refersTo": "dashboard-activity",
      "description": "Panel teal gelap dengan aksi berikutnya. Contoh keadaan kosong; aplikasi menggantinya dengan progres dan materi berikutnya atau status selesai sesuai state belajar.",
      "html": "<section class=\"ds-dashboard\"><h2>Belajarmu dimulai dari satu topik.</h2><p>Belum ada quest aktif. Pilih topik, isi kemampuan awal dan nilai kuis simulasi, lalu pilih materi untuk dipelajari.</p><a href=\"#rekomendasi\">Cari Materi</a><ol><li>Tentukan kebutuhan belajar</li><li>Pilih materi dari kandidat</li><li>Mulai quest dan catat progres</li></ol></section>",
      "css": ".ds-dashboard{background:var(--forest);color:var(--on-dark);border-radius:var(--radius);padding:36px;overflow-wrap:anywhere;font:15px/1.6 var(--font)}.ds-dashboard h2{font:650 27px/1.35 var(--font-heading);letter-spacing:-.02em;max-width:24ch;margin:0}.ds-dashboard p{max-width:62ch;margin:16px 0 24px}.ds-dashboard a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 18px;margin-top:8px;background:var(--forest);color:var(--paper);border:1px solid transparent;border-radius:var(--control-radius);font:600 13px/1.5 var(--font);text-decoration:none;transition:background var(--duration) var(--ease)}.ds-dashboard a:hover{background:var(--forest-hover)}.ds-dashboard a:active{filter:brightness(.92)}.ds-dashboard a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-dashboard ol{margin:32px 0 0;padding:24px 0 0 22px;border-top:1px solid #c7d5c8}.ds-dashboard li{padding:5px 0 5px 6px}.ds-dashboard li::marker{font-weight:650;color:var(--forest)}@media(max-width:1180px){.ds-dashboard{padding:28px}}@media(max-width:700px){.ds-dashboard{padding:24px 20px}.ds-dashboard h2{font-size:24px}}@media(prefers-reduced-motion:reduce){.ds-dashboard a{transition:none}}"
    }
  ],
